# EnvironmentFile for systemd; copy to .env and edit locally. Do not commit secrets.
AETHER_MQTT_HOST=127.0.0.1
AETHER_MQTT_PORT=1883
AETHER_MQTT_USER=aether
AETHER_MQTT_PASSWORD=CHANGE_ME
AETHER_NODE_B_HOST=
AETHER_SERIAL_PORT=/dev/ttyAMA0
AETHER_GPIO=1
GPIOZERO_PIN_FACTORY=lgpio
AETHER_ALLOW_SYSTEMCTL=1
AETHER_API_KEY=CHANGE_ME_API_KEY
AETHER_DATABASE=data/aether.sqlite
# InfluxDB 3 Core: backend only; never put this token in ESP32 Secrets.h.
AETHER_INFLUX_ENABLED=1
AETHER_INFLUX_URL=http://127.0.0.1:8181
AETHER_INFLUX_DATABASE=aether
AETHER_INFLUX_TOKEN=CHANGE_ME_INFLUX_TOKEN
AETHER_TARGET_URL=http://127.0.0.1:8001/health
AETHER_SIMULATE_HARDWARE=0
